# 秘密情報（APIキーなど）。絶対に共有しない
.env

# Maven がビルドしたときに作るファイル（いつでも作り直せる）
target/

# データベースファイル（取り込み直せば作り直せる）
data/*.db

# 撮影した画面の一時ファイル（毎回上書きされる）
data/tmp/

# 判断ログ（撮影した自分の画面が入るので共有しない）
data/logs/

# ゲームから取り出したアイコン（ゲームの絵なので共有しない。ExtractIconsMain で作り直せる）
data/icons/

# 確認用の画像（ゲームの画面が写っているので共有しない）
samples/

# Claude Code のこの PC だけの設定（共有しない）
.claude/settings.local.json
